# Compose configuration. Copy to .env; real .env files remain local.
BUILDAPK_IMAGE=buildapk:local
BUILDAPK_SOURCE=./fixtures/expo-minimal
BUILDAPK_OUTPUT=./output
BUILDAPK_SECRETS=./secrets
BUILDAPK_KEY_ALIAS=release
BUILDAPK_TIMEOUT_SECONDS=3600
BUILDAPK_GRADLE_WORKERS=2
BUILDAPK_GRADLE_HEAP_MB=2048
